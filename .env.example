# Copy to .env and fill in. Loaded via python-dotenv.
#   from dotenv import load_dotenv; load_dotenv()

# Google Gemini API key, for the extraction pass and the demo agent.
GEMINI_API_KEY=AIza...

# Model overrides. Defaults come from src/pipeline/config.py TIERS; confirm the
# exact ids on your account with:  python -m src.pipeline.run list-models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Hard ceiling for one pipeline run. Extraction aborts rather than spending
# past this, so a prompt bug cannot run up a bill unattended.
ALFRED_BUDGET_USD=10.00

# Parallel extraction calls.
ALFRED_CONCURRENCY=8
